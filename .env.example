PORT=3000
MONGODB_URI=mongodb://username:password@host:27017/database?authSource=database
APPLE_BUNDLE_ID=app.kritamcqs.iosapp
APPLE_PREMIUM_PRODUCT_ID=app.kritamcqs.iosapp.premium.6months
# App-specific shared secret from App Store Connect (never commit the real value).
APPLE_SHARED_SECRET=
# Numeric Apple app ID (not the bundle ID); required for Production signed-data verification.
APPLE_APP_ID=
# App Store Connect API credentials. These are validated at startup when configured
# and are required for App Store Server API calls, but not for verifying Apple-signed JWS data.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=/etc/kritamcqs/apple/SubscriptionKey_KEYID.p8
# Alternatively provide the PEM value with escaped newlines; never commit the real key.
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Comma-separated absolute paths to Apple's current DER-encoded root CA certificates.
# Required when devices return signedTransactionInfo without a legacy receipt.
APPLE_ROOT_CA_PATHS=/etc/kritamcqs/apple/AppleRootCA-G2.cer,/etc/kritamcqs/apple/AppleRootCA-G3.cer
# Set false only for isolated local testing. Keep true in production.
APPLE_ENABLE_ONLINE_CHECKS=true
# Daily renewal verification cron timezone (schedule: 0 6 * * *).
APPLE_RENEWAL_CRON_TIME_ZONE=Asia/Kolkata
JWT_SECRET=change-me
SESSION_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173

# Firebase push notifications. Use one method only.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
