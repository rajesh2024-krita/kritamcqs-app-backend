PORT=3000
MONGODB_URI=mongodb://username:password@host:27017/database?authSource=database
APPLE_BUNDLE_ID=app.kritamcqs.iosapp
APPLE_PREMIUM_PRODUCT_ID=app.kritamcqs.iosapp.premium.6months
# App-specific shared secret from App Store Connect (never commit the real value).
APPLE_SHARED_SECRET=
# Numeric Apple app ID; required for production notification verification.
APPLE_APP_ID=
# Comma-separated absolute paths to Apple's DER-encoded root CA certificates.
APPLE_ROOT_CA_PATHS=/etc/kritamcqs/apple/AppleRootCA-G3.cer
# Set false only for isolated local testing. Keep true in production.
APPLE_ENABLE_ONLINE_CHECKS=true
JWT_SECRET=change-me
SESSION_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173

# Firebase push notifications. Use one method only.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
